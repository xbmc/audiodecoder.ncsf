msgctxt "#30000"
msgid "Default length"
msgstr "Výchozí délka"

msgctxt "#30001"
msgid "Used if specified file does not provide the length."
msgstr "Použije se, pokud zadaný soubor neposkytuje délku."

msgctxt "#30002"
msgid "unused"
msgstr "nepoužito"

msgctxt "#30003"
msgid "{0:d} s"
msgstr "{0:d} s"

msgctxt "#30004"
msgid "Default fade out time"
msgstr "Výchozí doba zeslabení"

msgctxt "#30005"
msgid "Used if specified file does not provide the length and fade."
msgstr "Použije se, pokud zadaný soubor neposkytuje délku a dobu zeslabení."

msgctxt "#30006"
msgid "unused"
msgstr "nepoužito"

msgctxt "#30007"
msgid "{0:d} ms"
msgstr "{0:d} ms"

msgctxt "#30008"
msgid "Suppress opening silence"
msgstr "Potlačit počáteční ticho"

msgctxt "#30009"
msgid "Some files start with silent data, this prevents it and looks for the beginning."
msgstr "Některé soubory začínají tichem; tato volba ho přeskočí a vyhledá začátek."

msgctxt "#30010"
msgid "Suppress end silence"
msgstr "Potlačit koncové ticho"

msgctxt "#30011"
msgid "Some files end with silent data, this prevents it and looks for the end."
msgstr "Některé soubory končí tichem; tato volba ho přeskočí a vyhledá konec."

msgctxt "#30012"
msgid "Second of silence to check"
msgstr "Sekundy ticha ke kontrole"

msgctxt "#30013"
msgid "How many silent seconds are allowed before playback is stopped."
msgstr "Kolik sekund ticha je povoleno, než se přehrávání zastaví."

msgctxt "#30014"
msgid "{0:d} s"
msgstr "{0:d} s"
